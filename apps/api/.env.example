NODE_ENV=development
PORT=6001
WEB_ORIGIN=http://localhost:8000

DATABASE_URL=postgresql://aida:aida_dev_password@localhost:5434/aida

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Super Admin Seed (automatically seeded on API startup if not present)
ADMIN_EMAIL=admin@aida.app
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Primary AI Provider: Groq API (Live LLM & Transcription)
# Sign up at https://console.groq.com/keys for ultra-fast Llama 3.3 70B & Whisper Large v3
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Backup AI Provider: Cloudflare Workers AI (Automatic failover backup)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aida-uploads
S3_ACCESS_KEY_ID=aida_minio
S3_SECRET_ACCESS_KEY=aida_minio_password
S3_FORCE_PATH_STYLE=true

# mock: LlmProvider/TranscriptionProvider return realistic canned output, no
# external calls made. Switch to "live" only once real keys are set above.
AI_PROVIDER_MODE=mock

# Set to either "mock" (logs emails to terminal, sends nothing)
# or "live" (sends real emails via Brevo).
EMAIL_PROVIDER_MODE=mock

# Brevo (Sendinblue) — Free 300 emails/day without a custom domain!
# 1. Sign up free at https://brevo.com
# 2. Get your API key from https://app.brevo.com/settings/keys/api
# 3. Set EMAIL_FROM to your verified email (e.g. your Gmail)
BREVO_API_KEY=
EMAIL_FROM=AIDA <your_verified_email@gmail.com>

# Optional Resend fallback (requires custom domain)
# RESEND_API_KEY=

# Public app URL used in email links (password reset, weekly report unsubscribe)
APP_URL=http://localhost:8000

# Sentry error tracking (set DSN from https://sentry.io before going to production)
# SENTRY_DSN=

# Weekly report cron schedule (UTC, standard 5-field cron — default: Monday 08:00 UTC)
# WEEKLY_REPORT_CRON=0 8 * * 1
