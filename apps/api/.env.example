NODE_ENV=development
PORT=6001
WEB_ORIGIN=http://localhost:8000

DATABASE_URL=postgresql://aida:aida_dev_password@localhost:5434/aida

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Super Admin Seed (automatically seeded on API startup if not present)
ADMIN_EMAIL=admin@aida.app
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6001/auth/google/callback

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aida-uploads
S3_ACCESS_KEY_ID=aida_minio
S3_SECRET_ACCESS_KEY=aida_minio_password
S3_FORCE_PATH_STYLE=true

# mock: LlmProvider/TranscriptionProvider return realistic canned output, no
# external calls made. Switch to "live" only once real keys are set below.
AI_PROVIDER_MODE=mock

# Cloudflare Workers AI (Single Account for both LLM and Audio Transcription)
# 1. Sign up at https://dash.cloudflare.com/ (free, no credit card required)
# 2. Go to Workers AI -> Select "Use REST API"
# 3. Create an API Token with "Workers AI: Read" permissions
# 4. Copy your Account ID and API Token below:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# LLM: Cloudflare Workers AI OpenAI-compatible endpoint
# (Automatically computed from CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN if left blank)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FLASH=@cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_MODEL_PRO=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Audio Transcription: Cloudflare Workers AI Whisper
# (Uses CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN above)
TRANSCRIPTION_MODEL=@cf/openai/whisper

# Set to either "mock" (logs emails to terminal, sends nothing)
# or "live" (sends real emails via Brevo).
EMAIL_PROVIDER_MODE=mock

# Brevo (Sendinblue) — Free 300 emails/day without a custom domain!
# 1. Sign up free at https://brevo.com
# 2. Get your API key from https://app.brevo.com/settings/keys/api
# 3. Set EMAIL_FROM to your verified email (e.g. your Gmail)
BREVO_API_KEY=
EMAIL_FROM=AIDA <your_verified_email@gmail.com>

# Optional Resend fallback (requires custom domain)
# RESEND_API_KEY=
